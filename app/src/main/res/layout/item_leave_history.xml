<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/leaveTypeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sick Leave"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/leaveDatesTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/leaveTypeTextView"
        android:text="Oct 22 - Oct 24, 2025" />

    <TextView
        android:id="@+id/leaveReasonTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/leaveDatesTextView"
        android:text="Reason for leave" />

    <TextView
        android:id="@+id/leaveStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="Pending"
        android:textStyle="bold" />

</RelativeLayout>