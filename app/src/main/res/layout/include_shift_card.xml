<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/shiftTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Shift"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shiftDetailsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/shiftTitleTextView"
            android:layout_marginTop="8dp"
            android:text="Loading..." />

        <ImageView
            android:id="@+id/refreshShiftButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh Shift" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>